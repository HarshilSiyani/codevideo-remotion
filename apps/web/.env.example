# Vizmo Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# ANTHROPIC (Claude API)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# DATABASE (SQLite - Local Development)
# ===========================================
# Path to SQLite database file (defaults to ./vizmo.db)
DATABASE_PATH=./vizmo.db

# ===========================================
# ELEVENLABS (Voice Generation)
# ===========================================
ELEVENLABS_API_KEY=...

# ===========================================
# REMOTION LAMBDA (Production Rendering)
# ===========================================
# AWS credentials for Remotion Lambda
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render

# S3 bucket for rendered videos
REMOTION_SERVE_URL=https://your-bucket.s3.amazonaws.com

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
