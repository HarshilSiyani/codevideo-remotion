# Vizmo Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# ANTHROPIC (Claude API) - REQUIRED
# ===========================================
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# DATABASE (SQLite - Local Development)
# ===========================================
# Path to SQLite database file (defaults to ./vizmo.db)
DATABASE_PATH=./vizmo.db

# ===========================================
# ELEVENLABS (Voice Generation) - OPTIONAL
# ===========================================
# Leave empty to skip voiceover generation
ELEVENLABS_API_KEY=

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# AWS LAMBDA (Optional - for production scale)
# ===========================================
# Only needed if you want to use AWS Lambda for rendering
# For local development, leave these empty - uses local Remotion CLI
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# REMOTION_LAMBDA_FUNCTION_NAME=
# REMOTION_SERVE_URL=
