{
  "name": "vizmo",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered video generation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "studio": "npm run studio --workspace=@vizmo/remotion",
    "render": "npm run render --workspace=@vizmo/remotion",
    "db:migrate": "npm run migrate --workspace=@vizmo/web",
    "db:generate": "npm run generate --workspace=@vizmo/web"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
